# BorrowBox Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.

# --- Supabase (pre-populated automatically in Bolt) ---
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- OpenAI API Key ---
# This is stored as a Supabase Edge Function secret (server-side only).
# It is NEVER exposed to the frontend.
# Set it in Supabase: Project Settings > Edge Functions > Secrets
# Name: OPENAI_API_KEY
# Value: sk-your-openai-api-key-here
OPENAI_API_KEY=
